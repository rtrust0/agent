# 后端环境变量示例（复制为 .env）
APP_NAME=辰光Agent RBAC Backend
APP_ENV=development
APP_DEBUG=true

# SQLite 开发库；后期上线改为 MySQL，例如：
# DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/chenguang?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./rbac.db

# JWT
JWT_SECRET=change-me-in-production-change-me-32
JWT_EXPIRES_MINUTES=30
